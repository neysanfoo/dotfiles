theme = "Gruvbox Dark"

font-family = "JetBrainsMono Nerd Font"
font-size = 14

macos-titlebar-style = hidden
window-decoration = none
window-padding-x= 4
window-padding-y= 4
window-padding-balance = true


# Send Cmd+/ to the terminal as the kitty-keyboard sequence for <D-/>
# (macOS never forwards Cmd combos to TUIs on its own)
keybind = super+slash=csi:47;9u
